<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaperNote.App" Name="纸间" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppFontFamily">sans-serif</FontFamily>
      <ControlTheme x:Key="CustomTitleBarDecorations" TargetType="WindowDrawnDecorations"
                    BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
        <!-- Avalonia 12 draws the window title above extended client content. -->
        <Style Selector="^:has-titlebar /template/ Panel#PART_TitleTextPanel">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The Fluent chrome includes a fourth, disabled fullscreen button.
             Disabled caption buttons still occupy space above client content. -->
        <Style Selector="^ /template/ Button#PART_FullScreenButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="StickyTitleBarDecorations" TargetType="WindowDrawnDecorations"
                    BasedOn="{StaticResource CustomTitleBarDecorations}">
        <Style Selector="^ /template/ Button#PART_MinimizeButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MaximizeButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Text" Color="#292833" />
          <SolidColorBrush x:Key="Muted" Color="#71717E" />
          <SolidColorBrush x:Key="Faint" Color="#868591" />
          <SolidColorBrush x:Key="Canvas" Color="#F8F8FA" />
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Chrome" Color="#F1F1F5" />
          <SolidColorBrush x:Key="Border" Color="#E6E5EC" />
          <SolidColorBrush x:Key="Hover" Color="#EAE9F1" />
          <SolidColorBrush x:Key="Selected" Color="#E9E5F6" />
          <SolidColorBrush x:Key="Accent" Color="#7460B6" />
          <SolidColorBrush x:Key="AccentHover" Color="#6551A4" />
          <SolidColorBrush x:Key="AccentPressed" Color="#584591" />
          <SolidColorBrush x:Key="Danger" Color="#AC5148" />
          <SolidColorBrush x:Key="HoverOverlay" Color="#10000000" />
          <SolidColorBrush x:Key="White" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Primary" Color="#7460B6" />
          <SolidColorBrush x:Key="PrimaryHover" Color="#6551A4" />
          <SolidColorBrush x:Key="PrimaryPressed" Color="#584591" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Text" Color="#EEEFF5" />
          <SolidColorBrush x:Key="Muted" Color="#B4B5C3" />
          <SolidColorBrush x:Key="Faint" Color="#9293A5" />
          <SolidColorBrush x:Key="Canvas" Color="#191A21" />
          <SolidColorBrush x:Key="Surface" Color="#24252F" />
          <SolidColorBrush x:Key="Chrome" Color="#1E1F28" />
          <SolidColorBrush x:Key="Border" Color="#363743" />
          <SolidColorBrush x:Key="Hover" Color="#2D2E3B" />
          <SolidColorBrush x:Key="Selected" Color="#35304D" />
          <SolidColorBrush x:Key="Accent" Color="#BEACEF" />
          <SolidColorBrush x:Key="AccentHover" Color="#D0BFFA" />
          <SolidColorBrush x:Key="AccentPressed" Color="#AE98E5" />
          <SolidColorBrush x:Key="Danger" Color="#EF9A8D" />
          <SolidColorBrush x:Key="HoverOverlay" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="White" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Primary" Color="#7460B6" />
          <SolidColorBrush x:Key="PrimaryHover" Color="#6551A4" />
          <SolidColorBrush x:Key="PrimaryPressed" Color="#584591" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#7460B6" />
        <ColorPaletteResources x:Key="Dark" Accent="#BEACEF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Canvas}" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Window.custom-titlebar">
      <Setter Property="WindowDecorationsTheme" Value="{StaticResource CustomTitleBarDecorations}" />
    </Style>
    <Style Selector="Window.custom-titlebar.sticky">
      <Setter Property="WindowDecorationsTheme" Value="{StaticResource StickyTitleBarDecorations}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource White}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /><Setter Property="Foreground" Value="{DynamicResource White}" /></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryPressed}" /></Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverOverlay}" /></Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.settings-link"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,11" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.note-card"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.note-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.note-card:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.note-card:selected"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.nav.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.nav.selected Path"><Setter Property="Stroke" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="Window.library TextBox"><Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" /></Style>
    <Style Selector="Window.library Button.note-card Button.card-action"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Window.library Button.note-card:pointerover Button.card-action"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Window.library Button.note-card:focus-within Button.card-action"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Window.library Button.note-card:pointerover Border.card-frame"><Setter Property="BoxShadow" Value="0 4 14 0 #0C000000" /></Style>
    <Style Selector="Button.shortcut"><Setter Property="Background" Value="{DynamicResource Chrome}" /><Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToolTip"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.document-tool"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="7" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.document-tool:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.document-save"><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,5" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Background" Value="{DynamicResource Primary}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.document-save:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /></Style>
    <Style Selector="Window.sticky Button.note-tool"><Setter Property="CornerRadius" Value="6" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Window.sticky Button.quiet:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverOverlay}" /></Style>
    <Style Selector="Window.sticky Button.quiet:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverOverlay}" /></Style>
    <Style Selector="FlyoutPresenter.note-options"><Setter Property="Background" Value="{DynamicResource Chrome}" /><Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10" /></Style>
    <Style Selector="Button.note-option:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.note-choice"><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Button.note-choice.selected"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.note-choice:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="ContextMenu"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="6" /><Setter Property="MinWidth" Value="210" /></Style>
    <Style Selector="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,9" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
  </Application.Styles>
</Application>
